{
  "name": "lumina",
  "productName": "Lumina",
  "version": "1.3.1",
  "author": "Tianyi",
  "description": "A research-oriented paper reading tool with AI-powered interaction, knowledge base management, and Docker/SSH experiment execution",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:theme": "node --test --experimental-strip-types src/shared/utils/theme.test.mjs",
    "test:update": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/update/updateDiagnostics.test.ts src/main/services/update/ReleaseNotesService.test.ts && node --test scripts/build/validateReleaseAssets.test.mjs",
    "test:file": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/file/FileService.test.ts",
    "test:paper": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/paper/paperBlockClassifiers.test.ts src/main/services/paper/paperTextProcessing.test.ts src/main/services/paper/paperMarkdownBuilder.test.ts src/main/services/paper/paperFigureExtractor.test.ts src/main/services/paper/paperAssetLocalizer.test.ts src/main/services/paper/PaperService.test.ts",
    "test:paper-ocr": "node --test --experimental-strip-types src/main/services/paper/paperOcrPipeline.test.ts",
    "test:paper-markdown": "node --test --experimental-strip-types src/shared/utils/paperMarkdown.test.mjs",
    "test:paper-annotations": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/shared/utils/paperAnnotationAnchors.test.mjs src/shared/utils/paperAnnotationConflicts.test.mjs src/shared/utils/paperQuoteContext.test.mjs src/renderer/src/components/paper/composables/paperCanonicalTextIndex.test.mjs src/renderer/src/components/paper/composables/usePaperHighlightRenderer.test.mjs",
    "test:paper-translation": "node --test --experimental-strip-types src/shared/utils/paperTranslation.test.mjs src/main/services/paper/PaperTranslationCore.test.ts",
    "test:paper-chat": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/paper/PaperContextSearchToolService.test.ts src/renderer/src/components/paper/chat/message/paperChatReactStepContent.test.ts src/renderer/src/stores/paperChatStreamStore.test.ts",
    "test:prompt": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/chat/prompts/reactSystemPrompt.test.ts src/main/services/config/ConfigManager.test.ts src/main/services/chat/tools/UnifiedToolRegistry.test.ts src/main/services/chat/PromptBuilder.test.ts src/main/services/chat/ReactLoopService.test.ts",
    "test:plan-execute": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/chat/PlanExecuteService.test.ts src/main/services/lab/LabService.test.ts src/main/services/lab/tools/commandExecutionPolicy.test.ts src/main/services/lab/docker/DockerContainerService.test.ts src/main/services/lab/docker/DockerExecService.test.ts src/main/services/lab/docker/DockerTerminalService.test.ts src/main/services/lab/file/tarBuilder.test.ts src/main/services/lab/file/LabFileService.test.ts",
    "test:paper-web-search": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/paper-web-search/PaperWebSearchService.test.ts src/main/services/chat/tools/adapters/PaperWebSearchToolAdapter.test.ts",
    "test:ssh": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/lab/ssh/SshCommandExecutor.test.ts src/main/services/lab/ssh/SshConfigService.test.ts src/main/services/lab/ssh/SftpFileTransfer.test.ts src/main/services/lab/ssh/SshConnectionManager.test.ts src/main/services/lab/ssh/SshTerminalService.test.ts src/main/services/lab/ssh/SshStatsService.test.ts",
    "test:lab-tools": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/lab/tools/execTools.test.ts src/main/services/lab/tools/fileTools.test.ts src/renderer/src/stores/lab/labStore.test.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "set ELECTRON_BUILDER_ALLOW_UNRESOLVED_SYMLINKS=true&& npm run build && electron-builder --win",
    "build:mac": "npm run build && npm_config_electron_mirror= npm_config_electron_builder_binaries_mirror=https://cdn.npmmirror.com/binaries/electron-builder-binaries/ electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lancedb/lancedb": "^0.27.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apache-arrow": "^21.1.0",
    "dockerode": "^4.0.9",
    "docx": "^9.6.0",
    "echarts": "^6.0.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12",
    "gpt-tokenizer": "^3.4.0",
    "iconv-lite": "^0.7.0",
    "jszip2": "npm:jszip@3.10.1",
    "katex": "^0.16.45",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "marked": "^17.0.5",
    "officeparser": "^6.0.4",
    "openai": "^6.16.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "react": "^19",
    "react-dom": "^19",
    "ssh2": "^1.17.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.3.6",
    "zustand": "^5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.0.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5",
    "electron": "^40.8.5",
    "electron-builder": "^26.9.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^5",
    "prettier": "^3.7.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
