{
  "name": "sparrow-manus",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:theme": "node --test --experimental-strip-types src/shared/utils/theme.test.mjs",
    "test:paper": "node --loader ./scripts/test/tsAliasLoader.mjs --test --experimental-strip-types src/main/services/paper/paperBlockClassifiers.test.ts src/main/services/paper/paperTextProcessing.test.ts src/main/services/paper/paperMarkdownBuilder.test.ts src/main/services/paper/paperFigureExtractor.test.ts src/main/services/paper/paperAssetLocalizer.test.ts src/main/services/paper/PaperService.test.ts src/main/services/paper/paperAnnotationRecovery.test.ts",
    "test:paper-ocr": "node --test --experimental-strip-types src/main/services/paper/paperOcrPipeline.test.ts",
    "test:paper-markdown": "node --test --experimental-strip-types src/shared/utils/paperMarkdown.test.mjs",
    "test:paper-translation": "node --test --experimental-strip-types src/shared/utils/paperTranslation.test.mjs src/main/services/paper/PaperTranslationCore.test.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && npm_config_electron_mirror= npm_config_electron_builder_binaries_mirror=https://cdn.npmmirror.com/binaries/electron-builder-binaries/ electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lancedb/lancedb": "^0.27.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "apache-arrow": "^21.1.0",
    "dockerode": "^4.0.9",
    "docx": "^9.6.0",
    "electron-updater": "^6.3.9",
    "gpt-tokenizer": "^3.4.0",
    "jszip2": "npm:jszip@3.10.1",
    "katex": "^0.16.45",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "marked": "^17.0.5",
    "officeparser": "^6.0.4",
    "openai": "^6.16.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.0.10",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^40.8.5",
    "electron-builder": "^26.9.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
